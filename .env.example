# Illustrative names only: adapt to your stack and document required variables.
# Copy to an untracked .env file. Configure blank secrets locally.
# Never expose server secrets through public frontend variables.
APP_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Server-side PostgreSQL connection string; supply your local value.
DATABASE_URL=

# Server-side session/authentication secret; generate securely locally.
AUTH_SECRET=

# Optional bootstrap identity. Establish credentials using a secure local command
# or invitation; do not hard-code passwords in source or seed files.
BOOTSTRAP_ADMIN_EMAIL=

# Provider-specific names may differ. Use sandbox/test mode exclusively.
PAYMENT_MODE=test
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PRO_PRICE_ID=

# Only if required by the provider; never put a secret in this field.
PAYMENT_PUBLISHABLE_KEY=
